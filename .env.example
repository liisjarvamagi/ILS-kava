# Kopeeri see fail nimega .env.local ja täida väärtused.
# .env.local EI lähe kunagi GitHubi (.gitignore hoolitseb selle eest).
# Samad muutujad pane ka Vercelisse (Settings → Environment Variables).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Oma arvutis jäta localhost; VERCELIS pane oma päris aadress
# (nt https://ils-kava.vercel.app) või kustuta muutuja Vercelist
# hoopis ära — kood leiab õige aadressi ise. Localhost väärtust
# Vercelis kood ignoreerib, et kirjade lingid ei viitaks localhosti.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Hommikukirja saladused (AINULT server, mitte kunagi NEXT_PUBLIC) ──
# Supabase Dashboard → Settings → API → service_role (secret) võti:
SUPABASE_SERVICE_ROLE_KEY=
# resend.com → API Keys:
RESEND_API_KEY=
# Juhuslik pikk sõne (nt 40 tähte-numbrit), kaitseb croni käivitust
# ja allkirjastab loobumislinke:
CRON_SECRET=
# Saatja aadress. Testimiseks sobib vaikimisi onboarding@resend.dev
# (saadab AINULT Su enda Resendi konto aadressile). Päris saatmiseks
# kinnita Resendis oma domeen ja pane siia nt:
# EMAIL_FROM=I Land Sound <kava@ilandsound.ee>
EMAIL_FROM=
# Admini tõlkenupp (ET ⇄ EN Claude'iga). Võti: console.anthropic.com
# → API Keys. Tasuta paketti pole, aga festivali tõlkemahud maksavad
# mõne sendi. Ilma võtmeta äpp töötab, tõlkenupp lihtsalt ütleb seda.
ANTHROPIC_API_KEY=
